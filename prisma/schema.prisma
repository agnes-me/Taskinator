generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Comptes & foyers ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships   Membership[]
  linkedProfile Profile[]
  createdTasks  Task[]         @relation("TaskCreatedBy")
  completions   TaskCompletion[]
  createdEvents Event[]
  createdTemplates TaskTemplate[]
}

// Un foyer = une "équipe" qui partage les listes de tâches
model Household {
  id                    String    @id @default(cuid())
  name                  String
  inviteCode            String    @unique
  icsToken              String    @unique
  remindersPausedUntil  DateTime? // pause globale des rappels (ex: vacances)
  remindersPauseReason  String?
  createdAt             DateTime  @default(now())

  memberships Membership[]
  profiles    Profile[]
  zones       Zone[]
  categories  Category[]
  tasks       Task[]
  templates   TaskTemplate[]
  events      Event[]
}

// Relie un compte utilisateur (login) à un foyer
// role: "OWNER" | "MEMBER" (voir src/lib/types.ts — enums non supportés par SQLite)
model Membership {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

// Un "membre" du foyer au sens large : adulte avec compte, ou enfant sans compte.
// Utilisé pour assigner des tâches et personnaliser les templates (ex: 1 liste par enfant).
model Profile {
  id             String   @id @default(cuid())
  householdId    String
  displayName    String
  color          String   @default("#14b8a6")
  isChild        Boolean  @default(false)
  linkedUserId   String?
  createdAt      DateTime @default(now())

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkedUser   User?            @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignedTasks Task[]          @relation("TaskAssignee")
  completions   TaskCompletion[]
}

// ---------- Organisation : zones (maison) & catégories ----------

model Zone {
  id          String   @id @default(cuid())
  householdId String
  name        String
  icon        String   @default("🏠")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     Task[]
  templateItems TaskTemplateItem[]
}

// kind: "CHORE" | "SHOPPING" | "PACKING" | "EVENT" | "ADMIN" | "OTHER" (voir src/lib/types.ts)
model Category {
  id          String       @id @default(cuid())
  householdId String
  name        String
  color       String       @default("#0d9488")
  icon        String       @default("✅")
  kind        String       @default("OTHER")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     Task[]
  templateItems TaskTemplateItem[]
}

// ---------- Tâches & récurrence (façon Sweepy) ----------

// priority: "LOW" | "MEDIUM" | "HIGH"
// status: "TODO" | "DONE" | "SKIPPED"
// recurrenceType: "NONE" | "DAILY" | "WEEKLY" | "MONTHLY" | "CUSTOM_DAYS"
// (voir src/lib/types.ts — enums non supportés par SQLite)
model Task {
  id          String     @id @default(cuid())
  householdId String
  title       String
  description String?
  categoryId  String?
  zoneId      String?
  assigneeId  String?
  createdByUserId String

  priority    String     @default("MEDIUM")
  status      String     @default("TODO")

  dueDate     DateTime?

  // Récurrence
  recurrenceType     String @default("NONE")
  recurrenceInterval Int            @default(1) // ex: toutes les 2 semaines
  recurrenceWeekdays String?        // csv "1,3,5" (1=lundi ... 7=dimanche) pour WEEKLY ciblé
  lastCompletedAt    DateTime?

  // Pause des rappels pour CETTE tâche (vacances, travaux...)
  pausedUntil   DateTime?
  pauseReason   String?

  // Origine template / événement (retroplanning)
  eventId        String?
  templateItemId String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  zone         Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignee     Profile?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  templateItem TaskTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  completions  TaskCompletion[]

  @@index([householdId, status])
  @@index([householdId, dueDate])
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  profileId   String?
  completedByUserId String?
  completedAt DateTime @default(now())
  note        String?

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  completedBy User? @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)
}

// ---------- Templates & rétroplanning ----------

// type: "CHECKLIST" (liste simple) | "EVENT_PLANNING" (rétroplanning) — voir src/lib/types.ts
model TaskTemplate {
  id          String       @id @default(cuid())
  householdId String?      // null = template système partagé par défaut
  name        String
  description String?
  icon        String       @default("📋")
  type        String       @default("CHECKLIST")
  isSystem    Boolean      @default(false)
  createdByUserId String?
  createdAt   DateTime     @default(now())

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items     TaskTemplateItem[]
  events    Event[]
}

model TaskTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  categoryId  String?
  zoneId      String?
  // Rétroplanning : décalage en jours par rapport à la date de l'événement.
  // Négatif = avant l'événement (ex: -7 = J-7), 0 = jour J, positif = après.
  offsetDays  Int?
  // Si vrai, une tâche est générée par membre du foyer sélectionné (ex: valise par enfant)
  perPerson   Boolean  @default(false)
  sortOrder   Int      @default(0)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  zone     Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tasks    Task[]
}

// Un événement concret (ex: "Vacances à la mer", "Dîner avec les Dupont")
// sur lequel on applique un template EVENT_PLANNING pour générer les tâches datées.
model Event {
  id          String   @id @default(cuid())
  householdId String
  name        String
  eventDate   DateTime
  notes       String?
  templateId  String?
  createdByUserId String
  createdAt   DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  template  TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User          @relation(fields: [createdByUserId], references: [id])
  tasks     Task[]
}
